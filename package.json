{
  "name": "socketfuse-workspace",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "pnpm --filter @socketfuse/core build && pnpm --filter socketfuse build && pnpm --filter @socketfuse/docs build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "check": "pnpm check:quality",
    "check:e2e": "pnpm test:e2e",
    "check:quality": "pnpm check:static && pnpm check:runtime",
    "check:runtime": "pnpm test && pnpm build && pnpm docs:check && pnpm release:verify",
    "check:static": "pnpm lint && pnpm typecheck",
    "dev": "pnpm --filter @socketfuse/docs dev",
    "docs:api": "pnpm --filter @socketfuse/docs api",
    "docs:check": "pnpm --filter @socketfuse/docs build",
    "docs:dev": "pnpm --filter @socketfuse/docs dev",
    "lint": "eslint . --cache --concurrency=auto",
    "lint:fix": "eslint . --cache --concurrency=auto --fix",
    "playground:server": "pnpm --filter @socketfuse/test playground:server",
    "prepare": "husky",
    "release:preflight": "pnpm check:quality && pnpm check:e2e",
    "release:verify": "pnpm --filter @socketfuse/test release:verify",
    "test": "pnpm --filter @socketfuse/core test",
    "test:e2e": "pnpm --filter @socketfuse/test test:e2e",
    "test:watch": "pnpm --filter @socketfuse/core test:watch",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "9.39.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.8.1",
    "eslint-plugin-import-lite": "0.6.0",
    "eslint-plugin-jsonc": "3.4.1",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "typescript": "catalog:",
    "typescript-eslint": "8.67.0",
    "vue-eslint-parser": "10.4.1"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs,vue,json}": [
      "eslint --fix"
    ]
  }
}
