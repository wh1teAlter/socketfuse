{
  "name": "wws-workspace",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "pnpm --filter @wws/core build && pnpm --filter wws build && pnpm --filter @wws/docs build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm docs:check && pnpm release:verify",
    "dev": "pnpm --filter @wws/docs dev",
    "docs:api": "pnpm --filter @wws/docs api",
    "docs:check": "pnpm --filter @wws/docs build",
    "docs:dev": "pnpm --filter @wws/docs dev",
    "lint": "eslint . --cache --concurrency=auto",
    "lint:fix": "eslint . --cache --concurrency=auto --fix",
    "playground:server": "pnpm --filter @wws/test playground:server",
    "release:verify": "pnpm --filter @wws/test release:verify",
    "test": "pnpm --filter @wws/core test",
    "test:e2e": "pnpm --filter @wws/test test:e2e",
    "test:watch": "pnpm --filter @wws/core test:watch",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "9.39.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.8.1",
    "eslint-plugin-import-lite": "0.6.0",
    "eslint-plugin-jsonc": "3.4.1",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "16.5.0",
    "typescript": "catalog:",
    "typescript-eslint": "8.67.0",
    "vue-eslint-parser": "10.4.1"
  }
}
