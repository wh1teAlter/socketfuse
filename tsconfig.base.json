{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@socketfuse/core": ["./packages/core/src/index.ts"],
      "socketfuse": ["./packages/socketfuse/src/index.ts"],
      "socketfuse/protocol": ["./packages/socketfuse/src/protocol.ts"],
      "socketfuse/worker": ["./packages/socketfuse/src/worker.ts"]
    },
    "resolveJsonModule": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "noEmit": true,
    "isolatedDeclarations": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  }
}
