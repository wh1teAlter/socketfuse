{
  "name": "wws",
  "type": "module",
  "version": "0.0.1-beta.1",
  "description": "Share WebSocket connections across same-origin browser tabs with SharedWorker.",
  "keywords": [
    "sharedworker",
    "websocket",
    "browser",
    "multi-tab"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wh1teAlter/wws.git",
    "directory": "packages/wws"
  },
  "bugs": {
    "url": "https://github.com/wh1teAlter/wws/issues"
  },
  "homepage": "https://github.com/wh1teAlter/wws#readme",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["CHANGELOG.md", "LICENSE", "README.md", "dist"],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "beta"
  },
  "scripts": {
    "build": "node ./scripts/generate-inline-worker.mjs && tsdown",
    "lint:package": "publint --strict",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@wws/core": "workspace:*",
    "publint": "0.3.24",
    "rolldown": "1.2.2",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
