{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "../socketfuse/src/index.ts",
    "../socketfuse/src/protocol.ts",
    "../socketfuse/src/worker.ts"
  ],
  "entryPointStrategy": "resolve",
  "excludeExternals": true,
  "excludeInternal": true,
  "hideBreadcrumbs": true,
  "hidePageHeader": true,
  "lang": "zh",
  "name": "SocketFuse API",
  "out": "site/api/generated",
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "none",
  "sort": ["source-order"],
  "sourceLinkTemplate": "https://github.com/wh1teAlter/socketfuse/blob/{gitRevision}/{path}#L{line}",
  "tsconfig": "tsconfig.typedoc.json",
  "visibilityFilters": {
    "external": false,
    "inherited": false,
    "private": false,
    "protected": false
  }
}
